[user]
    name = Mykhailo Pohoda
    email = mykhailo.pohoda@bolt.eu
    signingkey = 8795B85B03FA3578
[color]
    ui = true
[format]
    pretty = oneline
[alias]
    up = "!git remote update -p; git merge --ff-only @{u}"
    news = log -p HEAD@{1}..HEAD@{0}
    ignore = update-index --assume-unchanged
    unignore = update-index --no-assume-unchanged
[credential]
    helper = osxkeychain
[push]
    default = current
[pull]
    rebase = true
[diff]
    algorithm = histogram
    submodule = log
    orderFile = ~/.config/git/diffOrder
    colorMoved = default
[fetch]
    recurseSubmodules = on-demand
    prune = true
[rerere]
    enabled = true
[status]
    submoduleSummary = true
[tig]
    line-graphics = utf-8
    ignore-space = all
    commit-order = topo
[commit]
    gpgSign = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[maintenance]
    repo = /Users/mykhailopohoda/repos/taxify/server
[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[log]
    date = iso
[merge]
    conflictstyle = zdiff3
[rebase]
    autosquash = true
    updateRefs = true
[submodule]
    recurse = true
