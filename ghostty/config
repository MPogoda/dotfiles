# Fonts — Monaspace: different variant per style
font-family = "Monaspace Argon"
font-family-bold = "Monaspace Xenon"
font-family-italic = "Monaspace Radon"
font-family-bold-italic = "Monaspace Krypton"

font-style-bold = Regular
font-style-italic = Regular
font-style-bold-italic = Regular

# Nerd Font fallback for icons
font-family = "Hack Nerd Font Mono"
font-family-bold = "Hack Nerd Font Mono"
font-family-italic = "Hack Nerd Font Mono"
font-family-bold-italic = "Hack Nerd Font Mono"

font-size = 12
font-thicken = false

# OpenType features
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09

# FreeType (Linux)
freetype-load-flags = hinting,force-autohint,monochrome,autohint

# Cursor
mouse-hide-while-typing = true

# Rendering
minimum-contrast = 1.1
unfocused-split-opacity = 0.7
scrollback-limit = 10000000

# Window
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
window-padding-color = extend
window-inherit-working-directory = true

# Quick terminal
quick-terminal-position = bottom

# Shell integration
shell-integration-features = cursor,sudo,title

# Custom shader
custom-shader = cursor_blaze_no_trail.glsl

# macOS
macos-titlebar-style = transparent

# Keybinds
keybind = global:super+escape=toggle_quick_terminal
keybind = super+page_up=scroll_page_up
keybind = super+ctrl+equal=equalize_splits
keybind = super+physical:four=goto_tab:4
keybind = super+shift+down=jump_to_prompt:1
