# Fonts — Monaspace: different variant per style
font-family = "Monaspace Argon"
font-family-bold = "Monaspace Xenon"
font-family-italic = "Monaspace Radon"
font-family-bold-italic = "Monaspace Krypton"

# Nerd Font fallback for icons
font-family = "Hack Nerd Font Mono"
font-family-bold = "Hack Nerd Font Mono"
font-family-italic = "Hack Nerd Font Mono"
font-family-bold-italic = "Hack Nerd Font Mono"

font-size = 14
adjust-cell-height = 10%

# OpenType features
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09

# FreeType (Linux)
freetype-load-flags = hinting,force-autohint,no-monochrome,autohint,light

# Theme
theme = Ayu Mirage

# Cursor
mouse-hide-while-typing = true

# Rendering
minimum-contrast = 1.1

# Window
window-padding-balance = true
window-padding-color = extend

# Quick terminal
quick-terminal-position = bottom

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s

# Shell integration
shell-integration-features = cursor,sudo,title

# Custom shader
custom-shader = cursor_blaze_no_trail.glsl
custom-shader = focus_cursor_pulse.glsl
custom-shader = cursor_jump_ghost.glsl

# Keybinds
keybind = global:super+escape=toggle_quick_terminal
keybind = super+physical:zero=last_tab
keybind = super+physical:nine=goto_tab:9
